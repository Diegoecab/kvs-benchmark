{
  "schemaVersion": 1,
  "name": "x4-mixed-50-50-capacity-covered",
  "dataset": { "keyCount": 10000, "payloadBytes": 900, "partitionBuckets": 64, "seed": 20260728, "distribution": "uniform" },
  "workload": { "readPercent": 50, "writePercent": 50, "writeMode": "idempotent", "consistency": "strong" },
  "load": {
    "model": "open-loop",
    "executionMode": "concurrent",
    "schedule": [
      { "seconds": 60, "operationsPerSecond": 100 },
      { "seconds": 60, "operationsPerSecond": 200 },
      { "seconds": 60, "operationsPerSecond": 400 },
      { "seconds": 60, "operationsPerSecond": 600 },
      { "seconds": 60, "operationsPerSecond": 300 }
    ],
    "maxInflight": 4096,
    "telemetryIntervalMs": 100
  },
  "client": { "maxConnections": 512, "requestTimeoutMs": 5000, "connectionTimeoutMs": 3000, "maxAttempts": 1 },
  "capacity": {
    "awsDynamodb": { "readCapacityUnits": 400, "writeCapacityUnits": 400 },
    "adbDynamodbApi": { "readCapacityUnits": 400, "writeCapacityUnits": 400, "mappedTableEcpu": 9 },
    "ociNosql": { "readUnits": 800, "writeUnits": 800, "storageGb": 10 }
  },
  "capacityCoverage": {
    "peakOperationsPerSecond": 600,
    "peakReadsPerSecond": 300,
    "peakWritesPerSecond": 300,
    "awsAndAdbRequired": { "read": 300, "write": 300 },
    "ociNosqlRequired": { "read": 600, "write": 600 },
    "plannedHeadroomPercent": 25
  }
}
