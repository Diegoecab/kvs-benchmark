{
  "schemaVersion": 1,
  "name": "phase1-x4-strong-capacity",
  "durationSeconds": 900,
  "maxRequestSkewMs": 250,
  "minimumLeadTimeSeconds": 30,
  "targets": {
    "aws": { "baseline": { "read": 400, "write": 400 }, "events": [{ "name": "scale-down", "atSecond": 180, "capacity": { "read": 200, "write": 200 } }, { "name": "scale-up", "atSecond": 480, "capacity": { "read": 400, "write": 400 } }] },
    "adb": { "baseline": { "read": 400, "write": 400 }, "events": [{ "name": "scale-down", "atSecond": 180, "capacity": { "read": 200, "write": 200 } }, { "name": "scale-up", "atSecond": 480, "capacity": { "read": 400, "write": 400 } }] },
    "ndcs": { "baseline": { "read": 800, "write": 800, "storageGB": 10 }, "events": [{ "name": "scale-down", "atSecond": 180, "capacity": { "read": 400, "write": 400, "storageGB": 10 } }, { "name": "scale-up", "atSecond": 480, "capacity": { "read": 800, "write": 800, "storageGB": 10 } }] }
  }
}
